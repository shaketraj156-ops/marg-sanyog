# Copy to ../.env (repo root, next to docker-compose.yml) and set real values.
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://app:change-me@db:5432/blockplanner
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SLOT_MINUTES=30
MAX_BLOCK_MINUTES=360
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
