# Local setup (no Docker, no Redis): copy this file to backend\.env and run from backend\.
# The defaults below work as they are. Change JWT_SECRET to your own long random string.
DATABASE_URL=sqlite:///./blockplanner.db
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SLOT_MINUTES=30
MAX_BLOCK_MINUTES=360
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Only for scripts/seed_synthetic.py: password given to every seeded demo user.
# Set it in the shell instead: $env:SEED_PASSWORD = "your-password"
# SEED_PASSWORD=

# --- Docker Compose only (copy to the repo root as .env instead of the SQLite line above) ---
# DB_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://app:change-me@db:5432/blockplanner
# REDIS_URL=redis://redis:6379/0
